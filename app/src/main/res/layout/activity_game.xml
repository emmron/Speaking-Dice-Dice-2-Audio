<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/f1_black">

    <!-- Lap counter -->
    <TextView
        android:id="@+id/tv_lap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/f1_white"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Current race position -->
    <TextView
        android:id="@+id/tv_position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/f1_gold"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Team name (coloured per team) -->
    <TextView
        android:id="@+id/tv_team_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_lap"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Tire status text -->
    <TextView
        android:id="@+id/tv_tire"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/f1_white"
        android:textSize="12sp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_position"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Red divider -->
    <View
        android:id="@+id/divider1"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:background="@color/f1_red"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_team_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tire wear label -->
    <TextView
        android:id="@+id/tv_tire_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TIRE WEAR"
        android:textColor="#888888"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@+id/divider1"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Tire wear percentage -->
    <TextView
        android:id="@+id/tv_tire_pct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/f1_white"
        android:textSize="10sp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/divider1"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tire wear ProgressBar -->
    <ProgressBar
        android:id="@+id/pb_tire_wear"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:max="100"
        android:progress="0"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_tire_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Race event announcement (background tinted per event type) -->
    <TextView
        android:id="@+id/tv_event"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/f1_white"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="16dp"
        android:minHeight="80dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toBottomOf="@+id/pb_tire_wear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Last lap result feedback -->
    <TextView
        android:id="@+id/tv_last_result"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_event"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Strategy buttons -->
    <Button
        android:id="@+id/btn_decision_1"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:textColor="@color/f1_white"
        android:backgroundTint="@color/f1_red"
        android:textSize="14sp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_last_result"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_decision_2"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:textColor="@color/f1_white"
        android:backgroundTint="@color/f1_dark_grey"
        android:textSize="14sp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_decision_1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_decision_3"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:textColor="@color/f1_white"
        android:backgroundTint="@color/f1_dark_grey"
        android:textSize="14sp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_decision_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- AdMob banner at bottom -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:adSize="BANNER"
        app:adUnitId="ca-app-pub-3940256099942544/6300978111"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
