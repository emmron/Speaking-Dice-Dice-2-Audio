# keystore.properties — copy this file to keystore.properties and fill in your values.
# NEVER commit keystore.properties to git (it's in .gitignore).
#
# Step 1 — Generate your keystore (run once, keep the .jks file safe forever):
#
#   keytool -genkey -v \
#     -keystore racestrategy.jks \
#     -alias racestrategy \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Step 2 — Fill in the values below and save as keystore.properties

storeFile=racestrategy.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=racestrategy
keyPassword=YOUR_KEY_PASSWORD

# Step 3 — Build a signed release AAB:
#   ./gradlew bundleRelease
#
# The AAB will be at:
#   app/build/outputs/bundle/release/app-release.aab
#
# Step 4 — Upload app-release.aab to Google Play Console.
